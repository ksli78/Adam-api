# vLLM Configuration for Adam RAG System
# Copy this to .env and adjust as needed

# LLM Backend Selection
# ---------------------
# Set to "vllm" to use vLLM, or "ollama" to use Ollama
LLM_BACKEND=vllm

# vLLM Configuration
# ------------------
VLLM_HOST=http://vllm:8000
# For local development (vLLM running on host):
# VLLM_HOST=http://localhost:8001

# LLM Model Configuration
# -----------------------
# HuggingFace model ID (vLLM will download automatically on first run)
LLM_MODEL=mistralai/Mistral-Small-Instruct-2409

# Context window size (must match --max-model-len in docker-compose.vllm.yml)
LLM_CONTEXT_WINDOW=16384

# Performance Tuning
# ------------------
# Request timeout (increase if getting timeouts)
VLLM_TIMEOUT=300  # 5 minutes

# Ollama Configuration (Legacy - keep for rollback)
# --------------------------------------------------
OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=mistral-small:22b

# Data Directory
# --------------
DATA_DIR=/data/airgapped_rag

# SQL Database Configuration
# --------------------------
# (Existing SQL config - no changes needed)
EMPLOYEE_DB_PASSWORD=your_password_here
